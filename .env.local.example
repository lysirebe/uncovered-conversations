# ── Sanity ────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Get these from https://sanity.io/manage → your project → Settings → API

# Project ID  (public — safe to commit)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Dataset name (public — usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# API token   (KEEP SECRET — never commit .env.local)
# Needs "Editor" role for the migration script; read-only token for the app.
SANITY_API_TOKEN=your_token_here
